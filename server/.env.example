# Copy to server/.env (git-ignored). Enables the vision-language-model FALLBACK used when OCR cannot identify a medicine.
# Any OpenAI-compatible vision endpoint works; the defaults below target Alibaba Cloud Model Studio (Qwen).
MEDSYNC_VLM_API_KEY=
MEDSYNC_VLM_BASE_URL=https://<workspace>.<region>.maas.aliyuncs.com/compatible-mode/v1
MEDSYNC_VLM_MODEL=qwen3.6-flash
# MEDSYNC_VLM=off     # disable the fallback even when a key is set
